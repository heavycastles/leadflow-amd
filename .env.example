# LLM backend: "openai" = any OpenAI-compatible server (vLLM on ROCm / AMD Developer Cloud MI300X), "mock" = offline rules
LLM_BACKEND=mock
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=EMPTY
LLM_TIMEOUT=30
# Label shown in the UI / metrics
LLM_HARDWARE=AMD Instinct MI300X (ROCm, vLLM)
# If the remote LLM fails, fall back to mock instead of erroring
LLM_FALLBACK=1
