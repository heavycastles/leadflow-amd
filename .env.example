# ---------------------------------------------------------------------------------------------
# LeadFlow AI — copy to .env (gitignored). serve.py loads it; real env vars win.
# ---------------------------------------------------------------------------------------------

# === Option A (primary, one key, no card): AMD Token Factory public model API ===
# Sign up: https://notebooks.amd.com/tokenfactory  (Public Free Model APIs → pick a model → copy key "rc-...")
# Setting this key alone switches the app to live mode:
#   base URL https://developer.amd.com.cn/radeon/api/v1 (OpenAI-compatible /chat/completions),
#   model Gemma-4-31B-IT (Google Gemma served on AMD GPUs)
AMD_TOKEN_FACTORY_API_KEY=
# RADEON_API_KEY= is accepted as an alias (name used in the Radeon Cloud docs)
# Default: Google Gemma (Gemma-4-31B-IT). Documented alternative: DeepSeek-V4-Flash (faster, see docs/live-proof.md).
# Any id from `python -m app.llm` / GET .../models works (e.g. DeepSeek-V4-Flash, GLM-5.3-Flash, Qwen3.8-27B)
AMD_TOKEN_FACTORY_MODEL=Gemma-4-31B-IT
# Optional: override the Token Factory base URL (e.g. a dedicated endpoint .../spaces/<id>/8000/v1)
# AMD_TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# === Option B (optional, real MI300X benchmarks): vLLM on ROCm / AMD Developer Cloud ===
# Explicit LLM_* values always win over the Token Factory defaults. Leave blank to use them.
#   LLM_BACKEND: "openai" = any OpenAI-compatible server, "mock" = offline rules (forces mock even with a key)
#   Default: openai if a Token Factory key is set, else mock.
LLM_BACKEND=
# e.g. http://<mi300x-droplet-ip>:8000/v1
LLM_BASE_URL=
# e.g. Qwen/Qwen2.5-7B-Instruct
LLM_MODEL=
# e.g. the VLLM_API_KEY you started vLLM with
LLM_API_KEY=

# === Common ===
# Gemma-4-31B-IT is slower than DeepSeek-V4-Flash; 60 s leaves headroom
LLM_TIMEOUT=60
# Label shown in the UI / metrics (default: Token Factory label with a key, else MI300X/vLLM)
LLM_HARDWARE=
# If the remote LLM fails, fall back to mock instead of erroring
LLM_FALLBACK=1
# Send response_format=json_object (set 0 if a model rejects it; JSON is still parsed from text)
LLM_JSON_MODE=1
